{
  "name": "playwright",
  "version": "1.0.0",
  "description": "Playwright automation tests for Stenograph One UI with POT screenshot recording",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "s1": "node scripts/s1-cli.js all",
    "s1:menu": "node scripts/s1-cli.js",
    "test:s1:menu": "node scripts/s1-cli.js",
    "test": "playwright test tests/role-navigation-pot.spec.js",
    "test:all": "playwright test",
    "test:s1:all": "playwright test tests/create-case-job-sync.spec.js --headed",
    "test:case": "playwright test tests/create-case.spec.js --headed",
    "test:job": "playwright test tests/create-job.spec.js --headed",
    "test:invite-user": "playwright test tests/invite-user.spec.js --headed",
    "test:create-user": "playwright test tests/create-user.spec.js --headed",
    "test:status": "playwright test tests/check-status.spec.js --headed",
    "login:fail": "playwright test tests/login-fail.spec.js --headed",
    "test:login:fail": "playwright test tests/login-fail.spec.js --headed",
    "test:case-job": "playwright test tests/create-case-job.spec.js --headed",
    "test:artifacts": "playwright test tests/job-artifacts-sync.spec.js --headed",
    "scan:artifacts": "node scripts/scan-artifacts.js",
    "scan:downloads": "node scripts/scan-artifacts.js",
    "test:syncgen": "playwright test tests/sync-gen-upload.spec.js --headed",
    "test:e2e": "playwright test tests/create-case-job-sync.spec.js --headed",
    "test:pot": "playwright test tests/role-navigation-pot.spec.js",
    "test:pot:headed": "playwright test tests/role-navigation-pot.spec.js --headed",
    "test:pot:admin": "playwright test tests/role-navigation-pot.spec.js -g \"Role: Organization Admin\" --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test tests/create-case-job-sync.spec.js --debug",
    "test:dynamic": "playwright test tests/dynamic-navigation.spec.js",
    "test:dynamic:headed": "playwright test tests/dynamic-navigation.spec.js --headed",
    "discover": "node scripts/run-dynamic-discovery.js",
    "test:utilites": "playwright test tests/utilities-flow.spec.js --headed",
    "test:utilities": "playwright test tests/utilities-flow.spec.js --headed",
    "test:report": "playwright show-report",
    "auth:cache": "node scripts/generate-auth-cache.js",
    "clear": "node scripts/cleanup.js",
    "clear:org": "node scripts/cleanup.js org",
    "clear:user": "node scripts/cleanup.js user",
    "clear:case": "node scripts/cleanup.js case",
    "clear:case-job": "node scripts/cleanup.js case-job",
    "clear:job": "node scripts/cleanup.js job",
    "clear:instance": "node scripts/cleanup.js instance",
    "clear:test-data": "node scripts/cleanup.js test-data",
    "cleanup": "node scripts/cleanup.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "docx": "^9.15.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0"
  }
}
